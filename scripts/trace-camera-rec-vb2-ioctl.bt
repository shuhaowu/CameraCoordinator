#!/usr/bin/bpftrace -v

// Needed for struct v4l2_fh
#include <media/v4l2-fh.h>

// Needed for struct video_device
#include <media/v4l2-dev.h>

// Needed for struct vb2_queue
#include <media/videobuf2-core.h>

kprobe:vb2_ioctl_streamon
{
  $file = (struct file *) arg0;
  if ($file == 0) {
    printf("vb2_ioctl_streamon detected but file == 0\n");
    return;
  }

  $dentry = $file->f_path.dentry;
  if ($dentry == 0) {
    printf("vb2_ioctl_streamon: dentry == 0\n");
    return;
  }

  $name = $dentry->d_name.name;
  printf("vb2_ioctl_streamon: file=%s\n", str($name)); // This will give video0, video1, etc.
}

kprobe:vb2_ioctl_streamoff
{
  $file = (struct file *) arg0;
  if ($file == 0) {
    printf("vb2_ioctl_streamoff detected but file == 0\n");
    return;
  }

  $dentry = $file->f_path.dentry;
  if ($dentry == 0) {
    printf("vb2_ioctl_streamoff: dentry == 0\n");
    return;
  }

  $name = $dentry->d_name.name;
  printf("vb2_ioctl_streamoff: file=%s\n", str($name));
}

// In some cases the app does not call vb2_ioctl_streamoff before the process
// is terminated. As a part of that termination, this code path is called.
// However this function is called for other reasons, so we check if the device
// was streaming before logging the event.
kprobe:vb2_fop_release
{
  $file = (struct file *) arg0;
  if ($file == 0) {
    printf("vb2_fop_release detected but file == 0\n");
    return;
  }

  $dentry = $file->f_path.dentry;
  if ($dentry == 0) {
    printf("vb2_fop_release: dentry == 0\n");
    return;
  }

  $name = $dentry->d_name.name;

  $fh = (struct v4l2_fh *)$file->private_data;
  $streaming = $fh->vdev->queue->streaming;

  // Only log release if the device was streaming. This is because there are
  // many reasons for release to be called that are not related to the camera
  // streaming being turned off.
  if ($streaming) {
    printf("vb2_fop_release: file=%s\n", str($name));
  }
}
